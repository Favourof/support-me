generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  // Nullable: a magic-link (#15) or OAuth (#14) account has no wallet
  // until the user connects one. Still unique when set, so a wallet can
  // never be claimed by more than one account.
  walletAddress  String?         @unique
  // Contact/sign-in address. Required for a magic-link account (that's
  // the whole identity); optional otherwise, where it's only used for
  // transactional email (recurring-donation renewal/failure, donation
  // -received notices).
  email          String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Set by POST /api/account/delete when the holder anonymizes their data;
  // kept as an audit marker (cleared fields are the actual erasure).
  deletedAt      DateTime?
  creator        Creator?
  adminAuditLogs AdminAuditLog[]
  magicLinks     MagicLinkToken[]
  oauthIdentities OAuthIdentity[]
}

// Links a third-party OAuth identity (Twitter/X, and any future provider)
// to a User (#14). provider+providerAccountId is what create-or-attach
// keys off: a returning user is matched by this pair, not by email.
model OAuthIdentity {
  id                Int      @id @default(autoincrement())
  provider          String
  providerAccountId String
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A single-use, short-lived sign-in token emailed to a user for magic-link
// authentication (#15). Only the SHA-256 hash of the token is stored.
model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  email     String
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
}

model AdminAuditLog {
  id                 Int      @id @default(autoincrement())
  adminId            Int?
  admin              User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminWalletAddress String
  action             String
  targetType         String
  targetId           String
  before             Json?
  after              Json?
  requestId          String?
  createdAt          DateTime @default(now())

  @@index([createdAt, id])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model Creator {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String         @unique
  walletAddress String
  displayName   String?
  bio           String?
  avatarUrl     String?
  socialLinks   Json?
  acceptsXlm    Boolean        @default(true)
  acceptsUsdc   Boolean        @default(true)
  donationGoal  Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  donations     Donation[]
  withdrawals   Withdrawal[]
  subscriptions Subscription[]

  @@index([walletAddress])
}

model Donation {
  id              Int                     @id @default(autoincrement())
  creator         Creator                 @relation(fields: [creatorId], references: [id])
  creatorId       Int
  senderAddress   String
  amount          Float
  currency        String                  @default("XLM")
  message         String?
  transactionHash String?
  // Stable identity for donations discovered from Soroban events. Replaying a
  // ledger lookback after a restart must not create another row.
  onChainEventId  String?                 @unique
  rpcEventId      String?                 @unique
  operationIndex  Int                     @default(0)
  eventIndex      Int                     @default(0)
  // Client-reported rows are provisional until the Soroban listener verifies
  // the corresponding event; legacy rows remain visible by default.
  verified        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  idempotencyKey  DonationIdempotencyKey?

  @@unique([transactionHash, operationIndex, eventIndex])
}

model DonationIdempotencyKey {
  key        String   @id
  donationId Int      @unique
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Withdrawal {
  id          Int      @id @default(autoincrement())
  creator     Creator  @relation(fields: [creatorId], references: [id])
  creatorId   Int
  amountIn    Float // crypto withdrawn (SEP-24 amount_in)
  amountOut   Float? // fiat received (amount_out), when the anchor reports it
  fee         Float? // amount_fee
  currency    String   @default("USDC") // asset withdrawn
  anchorTxId  String // SEP-24 transaction id
  stellarTxId String? // on-chain payment to the anchor (stellar_transaction_id)
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  // A given anchor transaction maps to exactly one withdrawal record. Lets the
  // POST handler be idempotent when the completion path fires more than once.
  @@unique([creatorId, anchorTxId])
}

model Subscription {
  id                Int       @id @default(autoincrement())
  creator           Creator   @relation(fields: [creatorId], references: [id])
  creatorId         Int
  supporterAddress  String
  token             String // asset code, e.g. "XLM" or "USDC"
  amount            Float // amount charged per interval
  intervalSecs      Int
  onChainId         Int       @unique // subscription_id returned by the donation contract's subscribe()
  subscribeTxHash   String?
  nextChargeAt      DateTime
  active            Boolean   @default(true)
  lastChargeTxHash  String?
  lastChargedAt     DateTime?
  // Set by the executor when a charge attempt fails (e.g. revoked allowance)
  // and cleared on the next successful charge, so failures are visible
  // without the executor retrying forever on its own.
  lastError         String?
  // When the supporter was last emailed about a failing charge, so the
  // executor (which retries every tick) sends one notice per failure streak
  // instead of one per retry. Cleared on the next successful charge.
  failureNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum EmailEventType {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

// One row per email send attempt, plus one row per delivery-status webhook
// (delivered/bounced/complained) Resend sends back for it. Keyed by
// recipient address rather than a User relation: webhook payloads only ever
// give us the address, and a bounce needs to be actionable even if the
// sending code path didn't have a User row on hand.
model EmailEvent {
  id                Int            @id @default(autoincrement())
  recipient         String
  subject           String
  type              EmailEventType
  // Resend's message id, so a later webhook (delivered/bounced/complained)
  // can be linked back to the SENT row for the same send. Null for send
  // attempts that failed before Resend returned an id.
  providerMessageId String?
  // Populated on FAILED/BOUNCED rows so the failure is diagnosable from the
  // row alone, without cross-referencing stdout logs.
  errorDetail       String?
  createdAt         DateTime       @default(now())

  @@index([recipient, createdAt])
  @@index([providerMessageId])
}
