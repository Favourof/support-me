# Copy this file to .env and update the values before running the backend.
DATABASE_URL="postgresql://postgres:password@localhost:5432/supportme?schema=public"
# PORT=4000
JWT_SECRET="your-secret-key-here-change-in-production"
NODE_ENV="development"

# Soroban event listener (polls for on-chain donations and streams them to
# the frontend over SSE at /api/events). Without the contract ID set, the
# listener logs a warning and skips polling.
NEXT_PUBLIC_DONATION_CONTRACT_ID="CD6T563YCSYQHDMXC7VCFTKMWMXWHFHAU4NO7EAMFK57QLFI7SSXICYY"
# Prefer a comma-separated pool. Requests try endpoints in order and retry the
# next endpoint after a transport error, timeout, or RPC error. The singular
# SOROBAN_RPC_URL setting remains supported for existing deployments.
# SOROBAN_RPC_URLS="https://soroban-testnet.stellar.org,https://backup-soroban.example/rpc"
# SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
# SOROBAN_RPC_TIMEOUT_MS=10000
# Optional: issuer used to map the USDC SAC in DonatedEvent payloads.
# SOROBAN_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA
# SOROBAN_USDC_TOKEN_ID=...
# SOROBAN_EVENTS_POLL_INTERVAL_MS=5000
# SOROBAN_EVENTS_LOOKBACK_LEDGERS=100

# Admin routes require both a signed-in wallet and an allowlisted wallet.
# ADMIN_WALLETS="GADMIN..."

# Recurring donations: periodically charges due subscriptions by calling the
# donation contract's charge_subscription, signed by this backend's own
# operational keypair. Without EXECUTOR_SECRET_KEY set, the executor logs a
# warning and skips charging (subscriptions can still be created/cancelled,
# they just won't auto-charge). This keypair must:
#   1. Be funded with a small amount of testnet XLM (just enough for fees —
#      it never custodies donor funds).
#   2. Have its public key registered as the contract's executor by the
#      contract admin, via donation_client.set_executor(&executor).
# Generate one with, e.g., `stellar keys generate executor` (Stellar CLI),
# then fund it via https://friendbot.stellar.org.
# EXECUTOR_SECRET_KEY="S..."
# SUBSCRIPTION_EXECUTOR_POLL_INTERVAL_MS=60000
